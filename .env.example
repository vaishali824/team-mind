# Local Hindsight uses embedded PostgreSQL and the Ollama service.
HINDSIGHT_MODE=local
HINDSIGHT_LOCAL_PORT=8888
HINDSIGHT_LOCAL_MODEL=llama3.2:1b
HINDSIGHT_LOCAL_NUM_CTX=4096
OLLAMA_BASE_URL=http://localhost:11434/v1

# TeamMind API
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional Hindsight Cloud mode instead of local mode:
# HINDSIGHT_MODE=cloud
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=